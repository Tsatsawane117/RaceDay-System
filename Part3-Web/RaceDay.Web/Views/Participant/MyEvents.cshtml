@model List<EnrolmentDto>
@{
    ViewData["Title"] = "My events";
}

<div class="page-header">
    <div class="container">
        <h1>My events</h1>
        <p>Every event you have entered, and where each entry stands.</p>
    </div>
</div>

<div class="container py-4">
    <partial name="_Alerts" />

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <div class="big">🏃</div>
            <h4>You have not entered any events yet</h4>
            <p>Browse the upcoming events and pick your first race.</p>
            <a asp-controller="Events" asp-action="Index" class="btn btn-raceday">Browse events</a>
        </div>
    }
    else
    {
        <div class="d-flex flex-wrap gap-3 mb-3 small">
            <span><span class="status-badge status-green">Confirmed</span> paid and in</span>
            <span><span class="status-badge status-amber">Pending</span> waiting for payment</span>
            <span><span class="status-badge status-red">Cancelled</span> withdrawn</span>
        </div>

        <div class="table-responsive">
            <table class="table table-raceday">
                <thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Bib</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td><a asp-controller="Events" asp-action="Details" asp-route-id="@e.EventID"><strong>@e.EventName</strong></a></td>
                            <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@e.CategoryName</td>
                            <td>@e.BibNumber</td>
                            <td><partial name="_StatusBadge" model="e.Status" /></td>
                            <td class="text-end">
                                <div class="d-flex flex-wrap gap-2 justify-content-end">
                                    @if (e.Status == "Pending")
                                    {
                                        <form asp-action="Pay" method="post" class="d-flex gap-1">
                                            <input type="hidden" name="enrolmentId" value="@e.EnrolmentID" />
                                            <select name="paymentMethod" class="form-select form-select-sm" style="width:auto">
                                                <option value="Card">Card</option>
                                                <option value="EFT">EFT</option>
                                                <option value="Cash">Cash</option>
                                            </select>
                                            <button type="submit" class="btn btn-raceday btn-sm">Pay @e.EntryFee.Money()</button>
                                        </form>
                                    }
                                    @if (e.Status != "Cancelled")
                                    {
                                        <form asp-action="Cancel" method="post" onsubmit="return confirm('Cancel this enrolment?');">
                                            <input type="hidden" name="enrolmentId" value="@e.EnrolmentID" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">Cancel</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
