@model EventDto
@{
    var banner = Assets.Resolve(Model.BannerUrl);
}
<div class="card event-card h-100">
    @if (banner != null)
    {
        <img src="@banner" class="event-card-img" alt="Banner for @Model.EventName" />
    }
    else
    {
        <div class="event-card-img event-card-placeholder"><span>@Model.EventType.Emoji()</span></div>
    }
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <span class="type-pill">@Model.EventType</span>
            <partial name="_StatusBadge" model="Model.Status" />
        </div>
        <h5 class="card-title">@Model.EventName</h5>
        <p class="text-muted small mb-1">📅 @Model.EventDate.ToString("dd MMM yyyy")</p>
        <p class="text-muted small mb-1">📍 @Model.Location</p>
        <p class="text-muted small mb-3">📏 @Model.DistanceKM.ToString("0.##") km</p>
        <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventID" class="btn btn-raceday mt-auto">View event</a>
    </div>
</div>
