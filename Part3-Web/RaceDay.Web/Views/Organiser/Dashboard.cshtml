@model DashboardVm
@{
    ViewData["Title"] = "Dashboard";
    var name = Context.Session.GetString(SessionKeys.FullName);
}

<div class="page-header">
    <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h1>Organiser dashboard</h1>
            <p>Welcome, @name. Here is how your events are doing.</p>
        </div>
        <a asp-action="CreateEvent" class="btn btn-raceday">➕ Create event</a>
    </div>
</div>

<div class="container py-4">
    <partial name="_Alerts" />

    <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="stat-tile"><div class="stat-number">@Model.Events.Count</div><div class="stat-label">Events created</div></div></div>
        <div class="col-md-4"><div class="stat-tile lime"><div class="stat-number">@Model.TotalEnrolments</div><div class="stat-label">Total enrolments</div></div></div>
        <div class="col-md-4"><div class="stat-tile navy"><div class="stat-number">@Model.Upcoming.Count</div><div class="stat-label">Upcoming events</div></div></div>
    </div>

    <h4>Upcoming events</h4>
    @if (Model.Upcoming.Count == 0)
    {
        <p class="text-muted">No upcoming events. <a asp-action="CreateEvent">Create one</a> to get started.</p>
    }
    else
    {
        <div class="row g-3 mb-4">
            @foreach (var ev in Model.Upcoming.Take(3))
            {
                <div class="col-md-4">
                    <div class="card h-100"><div class="card-body">
                        <div class="d-flex justify-content-between mb-2"><span class="type-pill">@ev.EventType</span><partial name="_StatusBadge" model="ev.Status" /></div>
                        <h5>@ev.EventName</h5>
                        <p class="mb-1 text-muted small">📅 @ev.EventDate.ToString("dd MMM yyyy")</p>
                        <p class="mb-0 text-muted small">👥 @ev.TotalEnrolments enrolled (@ev.ConfirmedEnrolments confirmed)</p>
                    </div></div>
                </div>
            }
        </div>
    }

    <h4>All my events</h4>
    @if (Model.Events.Count == 0)
    {
        <div class="empty-state"><div class="big">🏁</div><p>You have not created any events yet.</p></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-raceday">
                <thead><tr><th>Event</th><th>Date</th><th>Status</th><th class="text-center">Categories</th><th class="text-center">Enrolments</th><th></th></tr></thead>
                <tbody>
                    @foreach (var ev in Model.Events)
                    {
                        <tr>
                            <td><strong>@ev.EventName</strong><div class="text-muted small">@ev.Location</div></td>
                            <td>@ev.EventDate.ToString("dd MMM yyyy")</td>
                            <td><partial name="_StatusBadge" model="ev.Status" /></td>
                            <td class="text-center">@ev.CategoryCount</td>
                            <td class="text-center"><strong>@ev.TotalEnrolments</strong> <span class="text-muted small">(@ev.ConfirmedEnrolments confirmed)</span></td>
                            <td class="text-end"><a asp-action="Enrolments" asp-route-eventId="@ev.EventID" class="btn btn-sm btn-outline-raceday">View enrolments</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
