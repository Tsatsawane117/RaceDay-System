@model List<EventSummaryDto>
@{
    ViewData["Title"] = "Manage events";
}

<div class="page-header">
    <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h1>Manage events</h1>
            <p>Create, edit and run your events.</p>
        </div>
        <a asp-action="CreateEvent" class="btn btn-raceday">➕ Create event</a>
    </div>
</div>

<div class="container py-4">
    <partial name="_Alerts" />

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <div class="big">🏁</div>
            <h4>No events yet</h4>
            <p>Create your first event to start taking entries.</p>
            <a asp-action="CreateEvent" class="btn btn-raceday">Create event</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var ev in Model)
            {
                var banner = Assets.Resolve(ev.BannerUrl);
                <div class="col-md-6 col-lg-4">
                    <div class="card event-card h-100">
                        @if (banner != null)
                        {
                            <img src="@banner" class="event-card-img" alt="Banner for @ev.EventName" />
                        }
                        else
                        {
                            <div class="event-card-img event-card-placeholder"><span>@ev.EventType.Emoji()</span></div>
                        }
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="type-pill">@ev.EventType</span>
                                <partial name="_StatusBadge" model="ev.Status" />
                            </div>
                            <h5>@ev.EventName</h5>
                            <p class="text-muted small mb-1">📅 @ev.EventDate.ToString("dd MMM yyyy") &middot; 📍 @ev.Location</p>
                            <p class="text-muted small mb-3">👥 @ev.TotalEnrolments enrolled &middot; @ev.CategoryCount categories</p>

                            <div class="d-flex flex-wrap gap-2 mt-auto">
                                <a asp-action="EditEvent" asp-route-id="@ev.EventID" class="btn btn-sm btn-outline-raceday">✏️ Edit</a>
                                <a asp-action="Categories" asp-route-eventId="@ev.EventID" class="btn btn-sm btn-outline-raceday">🏷️ Categories</a>
                                <a asp-action="Enrolments" asp-route-eventId="@ev.EventID" class="btn btn-sm btn-outline-raceday">👥 Enrolments</a>
                                <a asp-action="Results" asp-route-eventId="@ev.EventID" class="btn btn-sm btn-outline-raceday">⏱️ Results</a>
                                <form asp-action="DeleteEvent" asp-route-id="@ev.EventID" method="post" onsubmit="return confirm('Delete this event? This cannot be undone.');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">🗑️ Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
