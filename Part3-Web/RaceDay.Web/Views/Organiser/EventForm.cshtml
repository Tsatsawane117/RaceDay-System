@model EventFormVm
@{
    var isEdit = Model.EventId.HasValue;
    ViewData["Title"] = isEdit ? "Edit event" : "Create event";
    var banner = Assets.Resolve(Model.ExistingBannerUrl);
}

<div class="page-header">
    <div class="container">
        <h1>@(isEdit ? "Edit event" : "Create event")</h1>
        <p>Tell participants what, when and where.</p>
    </div>
</div>

<div class="container py-4">
    <partial name="_Alerts" />

    <div class="form-card">
        <form method="post" enctype="multipart/form-data" asp-action="@(isEdit ? "EditEvent" : "CreateEvent")" asp-route-id="@Model.EventId">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <input type="hidden" asp-for="ExistingBannerUrl" />

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="EventName" class="form-label"></label>
                    <input asp-for="EventName" class="form-control" />
                    <span asp-validation-for="EventName" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="EventDate" class="form-label"></label>
                    <input asp-for="EventDate" type="date" class="form-control" />
                    <span asp-validation-for="EventDate" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" />
                    <span asp-validation-for="Location" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="DistanceKM" class="form-label"></label>
                    <input asp-for="DistanceKM" type="number" step="0.1" min="0.1" class="form-control" />
                    <span asp-validation-for="DistanceKM" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="EventType" class="form-label"></label>
                    <select asp-for="EventType" class="form-select">
                        <option value="Run">🏃 Run</option>
                        <option value="Walk">🚶 Walk</option>
                        <option value="Cycle">🚴 Cycle</option>
                    </select>
                    <span asp-validation-for="EventType" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" rows="4" class="form-control"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Status" class="form-label">Status</label>
                    <select asp-for="Status" class="form-select">
                        <option value="Planned">Planned (not open for entries)</option>
                        <option value="Open">Open for entries</option>
                        <option value="Closed">Closed</option>
                        <option value="Completed">Completed</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>

                <div class="col-md-8">
                    <label asp-for="BannerFile" class="form-label"></label>
                    <input asp-for="BannerFile" type="file" accept="image/png,image/jpeg,image/gif,image/webp" class="form-control" />
                    <div class="form-text">JPG, PNG, GIF or WEBP, up to 5 MB. The image is stored in Azure Blob Storage.</div>
                    <span asp-validation-for="BannerFile" class="text-danger small"></span>
                    @if (banner != null)
                    {
                        <div class="mt-2"><img src="@banner" alt="Current banner" style="max-height:90px;border-radius:8px;" /> <span class="small text-muted">Current banner (upload a new one to replace it)</span></div>
                    }
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-raceday">@(isEdit ? "Save changes" : "Create event")</button>
                <a asp-action="Events" class="btn btn-outline-raceday">Cancel</a>
            </div>
        </form>
    </div>
</div>
