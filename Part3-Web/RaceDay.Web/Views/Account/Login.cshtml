@model LoginVm
@{
    ViewData["Title"] = "Log in";
}

<div class="auth-wrap">
    <partial name="_Alerts" />
    <div class="card auth-card">
        <h2>Welcome back</h2>
        <p class="text-muted">Log in to enter events, track your results or manage your races.</p>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-raceday w-100">Log in</button>
        </form>

        <p class="text-center mt-3 mb-0">New to RaceDay? <a asp-action="Register">Create an account</a></p>
    </div>
</div>
