@model ProfilePageVm
@{
    ViewData["Title"] = "My profile";
    var picture = Assets.Resolve(Model.User.ProfilePictureUrl);
}

<div class="page-header">
    <div class="container">
        <h1>My profile</h1>
        <p>@Model.User.Email &middot; @Model.User.Role</p>
    </div>
</div>

<div class="container py-4">
    <partial name="_Alerts" />

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="form-card text-center">
                @if (picture != null)
                {
                    <img src="@picture" class="avatar mb-3" alt="Profile picture of @Model.User.FullName" />
                }
                else
                {
                    <div class="avatar-initials mx-auto mb-3">@DisplayHelpers.Initials(Model.User.FullName)</div>
                }
                <h4>@Model.User.FullName</h4>

                <form asp-action="Picture" method="post" enctype="multipart/form-data" class="mt-3 text-start">
                    <label class="form-label" for="picture">Profile picture</label>
                    <input id="picture" name="picture" type="file" accept="image/png,image/jpeg,image/gif,image/webp" class="form-control mb-2" />
                    <div class="form-text mb-2">JPG, PNG, GIF or WEBP, up to 5 MB. Stored in Azure Blob Storage.</div>
                    <button type="submit" class="btn btn-raceday w-100">Upload picture</button>
                </form>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="form-card">
                <h4>Personal details</h4>
                <form asp-action="Update" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input class="form-control" value="@Model.User.Email" disabled />
                        <div class="form-text">Your email address and role cannot be changed here.</div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Form.FullName" class="form-label"></label>
                        <input asp-for="Form.FullName" class="form-control" />
                        <span asp-validation-for="Form.FullName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Form.ContactNumber" class="form-label"></label>
                        <input asp-for="Form.ContactNumber" class="form-control" />
                        <span asp-validation-for="Form.ContactNumber" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-raceday">Save changes</button>
                </form>
            </div>
        </div>
    </div>
</div>
